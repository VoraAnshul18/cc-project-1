# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studentDB?retryWrites=true&w=majority
DB_NAME=studentDB

# CORS - Frontend Deployed URL on Vercel
FRONTEND_URL=https://frontend-delta-three-76.vercel.app
